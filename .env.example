# Copy to .env (never commit it) or set these in your shell.
HASSAN_AI_MODE=mock                 # mock | live
HASSAN_PORT=8787
HASSAN_GATEWAY_URL=http://127.0.0.1:4000/v1
HASSAN_GATEWAY_KEY=                 # LiteLLM master key, if you set one
# Folders the agents may work in (separate with ; on Windows, : on Linux/macOS)
HASSAN_ALLOWED_ROOTS=C:\Users\Hassan\Projects
HASSAN_MAX_REPAIR_ROUNDS=2
HASSAN_OPENHANDS_URL=http://127.0.0.1:3000
